@page "/cuidados/crear"
@attribute [Authorize]
@inject IRepository repository
@inject SweetAlertService swal
@inject NavigationManager navigationManager

<PageTitle>Crear Cuidado</PageTitle>

<h3>Nuevo Cuidado</h3>

<EditForm Model="cuidado" OnValidSubmit="CrearCuidado">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Siembra Activa:</label>
        <select class="form-select" @bind="cuidado.SiembraId">
            <option value="0">-- Seleccione una siembra --</option>
            @if (siembras != null)
            {
                @foreach (var siembra in siembras)
                {
                    <option value="@siembra.Id">Siembra #@siembra.Id</option>
                }
            }
        </select>
        @if (cuidado.SiembraId == 0)
        {
            <div class="text-danger">Debe seleccionar una siembra.</div>
        }
    </div>

    <div class="mb-3">
        <label>Fecha y Hora:</label>
        <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="fechaLocal" />
    </div>

    <div class="mb-3">
        <label>Tipo de Actividad:</label>
        <InputSelect class="form-select" @bind-Value="cuidado.TipoActividad">
            <option value="">-- Seleccione un tipo --</option>
            <option value="Riego">Riego</option>
            <option value="Abonado">Abonado</option>
            <option value="Poda">Poda</option>
            <option value="ControlPlagas">Control Plagas</option>
            <option value="Otra">Otra</option>
        </InputSelect>
        <ValidationMessage For="@(() => cuidado.TipoActividad)" />
    </div>

    <div class="mb-3">
        <label>Descripción:</label>
        <InputText class="form-control" @bind-Value="cuidado.Descripcion" />
        <ValidationMessage For="@(() => cuidado.Descripcion)" />
    </div>

    <button class="btn btn-primary" type="submit">Guardar</button>
    <button class="btn btn-secondary" @onclick="Regresar" type="button">Cancelar</button>
</EditForm>

@code {
    private CrearActividadCuidadoDto cuidado = new();
    private List<Siembra>? siembras;
    private DateTime fechaLocal = DateTime.Now;

    protected override async Task OnInitializedAsync()
    {
        await CargarSiembras();
    }

    private async Task CargarSiembras()
    {
        var responseHttp = await repository.GetAsync<List<Siembra>>("api/Siembras");
        if (responseHttp.Error)
        {
            var mensaje = await responseHttp.GetErrorMessageAsync();
            await swal.FireAsync("Error", mensaje, SweetAlertIcon.Error);
            return;
        }
        siembras = responseHttp.Response?
    .Where(s => s.Estado == EstadoSiembra.Activa)
    .ToList() ?? new List<Siembra>();
    }

    private async Task CrearCuidado()
    {
        cuidado.FechaHora = fechaLocal.ToUniversalTime();

        var responseHttp = await repository.PostAsync("api/cuidados", cuidado);
        if (responseHttp.Error)
        {
            var mensaje = await responseHttp.GetErrorMessageAsync();
            await swal.FireAsync("Error", mensaje, SweetAlertIcon.Error);
            return;
        }

        navigationManager.NavigateTo("/cuidados");
    }

    private void Regresar()
    {
        navigationManager.NavigateTo("/cuidados");
    }
}