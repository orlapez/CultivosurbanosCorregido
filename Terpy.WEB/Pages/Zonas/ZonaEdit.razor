@page "/zonas/editar/{Id:int}"
@attribute [Authorize]
@inject IRepository Repository
@inject NavigationManager Navigation

<h3>Editar zona</h3>

@if (cargando)
{
    <p>Cargando...</p>
}
else if (dto is null)
{
    <div class="alert alert-danger">@mensajeError</div>
    <a class="btn btn-secondary" href="/zonas">Volver</a>
}
else
{
    @if (mensajeError is not null)
    {
        <div class="alert alert-danger">@mensajeError</div>
    }

    <EditForm Model="dto" OnValidSubmit="ActualizarAsync">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Huerta</label>
            <input class="form-control" value="@nombreHuerta" disabled />
        </div>

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText class="form-control" @bind-Value="dto.Nombre" />
            <ValidationMessage For="() => dto.Nombre" />
        </div>

        <div class="mb-3">
            <label class="form-label">Descripción (opcional)</label>
            <InputTextArea class="form-control" @bind-Value="dto.Descripcion" />
            <ValidationMessage For="() => dto.Descripcion" />
        </div>

        <button class="btn btn-primary" type="submit" disabled="@guardando">Guardar cambios</button>
        <a class="btn btn-secondary" href="/zonas">Cancelar</a>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private ActualizarZonaDto? dto;
    private string nombreHuerta = "";
    private bool cargando = true;
    private bool guardando;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        var respZona = await Repository.GetAsync<Zona>($"api/zonas/{Id}");
        if (respZona.Error)
        {
            mensajeError = await respZona.GetErrorMessageAsync();
            cargando = false;
            return;
        }

        var zona = respZona.Response!;
        dto = new ActualizarZonaDto
        {
            Nombre = zona.Nombre,
            Descripcion = zona.Descripcion
        };

        var respHuerta = await Repository.GetAsync<Huerta>($"api/huertas/{zona.HuertaId}");
        nombreHuerta = respHuerta.Error ? $"Huerta {zona.HuertaId}" : respHuerta.Response!.Nombre;

        cargando = false;
    }

    private async Task ActualizarAsync()
    {
        guardando = true;
        mensajeError = null;

        var respuesta = await Repository.PutAsync($"api/zonas/{Id}", dto!);
        if (respuesta.Error)
        {
            mensajeError = await respuesta.GetErrorMessageAsync(); //si hay nombre repetido
            guardando = false;
            return;
        }

        Navigation.NavigateTo("/zonas");
    }
}