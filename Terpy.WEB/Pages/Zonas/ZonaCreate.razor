@page "/zonas/crear"
@attribute [Authorize]
@inject IRepository Repository
@inject NavigationManager Navigation

<h3>Nueva zona</h3>

@if (cargando)
{
    <p>Cargando huertas...</p>
}
else if (errorCarga is not null)
{
    <div class="alert alert-danger">@errorCarga</div>
    <a class="btn btn-secondary" href="/zonas">Volver</a>
}
else if (huertas.Count == 0)
{
    <div class="alert alert-warning">
        No tienes huertas disponibles. <a href="/huertas/crear">Crea una huerta</a> primero.
    </div>
}
else
{
    @if (mensajeError is not null)
    {
        <div class="alert alert-danger">@mensajeError</div>
    }

    <EditForm Model="dto" OnValidSubmit="CrearAsync">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Huerta</label>
            <InputSelect class="form-select" @bind-Value="dto.HuertaId">
                <option value="0">-- Selecciona una huerta --</option>
                @foreach (var huerta in huertas)
                {
                    <option value="@huerta.Id">@huerta.Nombre</option>
                }
            </InputSelect>
            <ValidationMessage For="() => dto.HuertaId" />
        </div>

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText class="form-control" @bind-Value="dto.Nombre" />
            <ValidationMessage For="() => dto.Nombre" />
        </div>

        <div class="mb-3">
            <label class="form-label">Descripción (opcional)</label>
            <InputTextArea class="form-control" @bind-Value="dto.Descripcion" />
            <ValidationMessage For="() => dto.Descripcion" />
        </div>

        <button class="btn btn-primary" type="submit" disabled="@guardando">Guardar</button>
        <a class="btn btn-secondary" href="/zonas">Cancelar</a>
    </EditForm>
}

@code {
    private CrearZonaDto dto = new();
    private List<Huerta> huertas = new();
    private bool cargando = true;
    private bool guardando;
    private string? errorCarga;
    private string? mensajeError;

    protected override async Task OnInitializedAsync()
    {
        var respuesta = await Repository.GetAsync<List<Huerta>>("api/huertas");
        if (respuesta.Error)
        {
            errorCarga = await respuesta.GetErrorMessageAsync();
        }
        else
        {
            huertas = respuesta.Response ?? new();
        }

        cargando = false;
    }

    private async Task CrearAsync()
    {
        guardando = true;
        mensajeError = null;

        var respuesta = await Repository.PostAsync("api/zonas", dto);
        if (respuesta.Error)
        {
            mensajeError = await respuesta.GetErrorMessageAsync();
            guardando = false;
            return;
        }

        Navigation.NavigateTo("/zonas");
    }
}